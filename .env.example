# Скопируйте в .env и заполните своими значениями.
# Переменные читаются из окружения процесса (экспорт/докер/CI), .env сам по себе
# не загружается — используйте `export $(grep -v '^#' .env | xargs)` или docker compose.

# Корень репозитория (по умолчанию вычисляется от src/config.py)
# PROJECT_ROOT=/path/to/INBICST_hack80
# DATA_DIR=/path/to/INBICST_hack80/данные
# ARTIFACTS_DATA_DIR=/path/to/INBICST_hack80/data

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=mipt_regulations

# OCR.space (нужен только для новых сканов; для корпуса из репозитория работает кэш)
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# Эмбеддинги
DENSE_MODEL_NAME=intfloat/multilingual-e5-large
# Куда fastembed скачивает модель (по умолчанию <repo>/models_cache)
# MODELS_CACHE_DIR=/path/to/models_cache
# Если модель уже скачана вручную (ONNX-каталог) — путь к ней
# DENSE_MODEL_PATH=/path/to/e5-large-onnx
# Число потоков ONNX и batch (для CPU)
# DENSE_THREADS=8
# DENSE_BATCH_SIZE=16

# Порог отказа от ответа (e5-large)
DENSE_ABSTAIN_THRESHOLD=0.815
# Сколько символов родительского раздела отдавать в контекст
PARENT_SECTION_MAX_CHARS=12000
