# Polza AI API (OpenAI-compatible endpoint for BGE-M3 embeddings, Qwen3-VL OCR, and Tool-Calling LLM)
POLZA_API_KEY=your_polza_api_key_here
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_EMBEDDING_MODEL=baai/bge-m3
POLZA_VLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
POLZA_LLM_MODEL=openai/gpt-4o-mini

# OCR Configuration (hybrid_vlm | local_rapidocr)
OCR_BACKEND=hybrid_vlm

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mipt_normative_v3

# Storage & Directories
DOCS_DIR=доки
DATA_DIR=data
CONFIG_DIR=config

# Web Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
