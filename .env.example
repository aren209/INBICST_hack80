# Local Linear-Hybrid LLM: Qwen/Qwen3.8-27B in 4-bit quantization
# Modes: "local_vllm" (recommended: vLLM serving RedHatAI/Qwen3.8-27B-INT4 on port 8001)
#     or "local_bnb_4bit" (in-process HuggingFace BitsAndBytes NF4)
LLM_BACKEND=local_vllm
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_PORT=8001
LOCAL_LLM_API_KEY=local-qwen38-4bit
LOCAL_LLM_MODEL=Qwen/Qwen3.8-27B
LOCAL_LLM_HF_QUANTIZED_REPO=RedHatAI/Qwen3.8-27B-INT4
LLM_QUANTIZATION=4bit
LLM_ENABLE_THINKING=false
VLLM_GPU_MEMORY_UTILIZATION=0.68
VLLM_MAX_MODEL_LEN=65536

# Local Dense Embeddings (BAAI/bge-m3, 1024d Cosine via SentenceTransformers)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Local Vision-Language OCR (PaddlePaddle/PaddleOCR-VL-1.6 + RapidOCR v3 PP-OCRv5 ESLAV fallback)
OCR_BACKEND=paddleocr_vl
OCR_VL_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
OCR_VL_DEVICE=auto

# Optional HuggingFace Hub Token (for faster open-weight downloads on first cold start)
HF_TOKEN=

# Optional Legacy External Cloud Overrides (leave empty for 100% on-prem execution)
DEEPSEEK_API_KEY=
POLZA_API_KEY=

# Qdrant Vector Database (for local host runs; Docker Compose automatically routes to http://qdrant:6333)
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mipt_normative_v3

# Docker Runtime Behavior
AUTO_SYNC_ON_STARTUP=false
QDRANT_WAIT_TIMEOUT=60

# Storage & Directories
DOCS_DIR=documents
DATA_DIR=data
CONFIG_DIR=config

# Web Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
